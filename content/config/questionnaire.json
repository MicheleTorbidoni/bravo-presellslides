{
  "groups": [
    {
      "title": "Interlocutore",
      "phase": 1,
      "items": [
        {
          "field": "contact_roles",
          "label": "Di cosa si occupa in azienda?",
          "type": "multi_select",
          "options": [
            "Titolare / Amministratore",
            "Socio",
            "Responsabile Commessa",
            "Responsabile Produzione",
            "Direttore di Stabilimento",
            "Responsabile Amministrativo",
            "Responsabile IT",
            "Responsabile Acquisti",
            "Consulente",
            "Impiegato/a",
            "Altro"
          ]
        },
        {
          "field": "contact_role_other",
          "label": "Specifica",
          "type": "text",
          "visible_if": { "field": "contact_roles", "includes": "Altro" }
        }
      ]
    },
    {
      "title": "Produzione & macchine",
      "phase": 1,
      "items": [
        { "ref": "d1" },
        { "ref": "d2" }
      ]
    },
    {
      "title": "Gestione & software",
      "phase": 1,
      "items": [
        { "ref": "d3" },
        {
          "field": "production_management_software_name",
          "label": "Quale software utilizzate?",
          "type": "text",
          "visible_if": { "ref": "d3", "equals": "mrp" }
        },
        { "ref": "d4" },
        { "ref": "d5" }
      ]
    },
    {
      "title": "Terziarizzazione",
      "phase": 1,
      "items": [
        { "field": "does_subcontract_manufacturing", "label": "Svolgete lavorazioni conto terzi?", "type": "boolean" },
        {
          "field": "subcontract_turnover_percentage",
          "label": "Quanto incidono sul fatturato?",
          "type": "percentage",
          "visible_if": { "field": "does_subcontract_manufacturing", "equals": true }
        },
        { "field": "does_outsource_work", "label": "Affidate alcune lavorazioni in outsourcing?", "type": "boolean" }
      ]
    },
    {
      "title": "Criticità attuali",
      "phase": 1,
      "items": [
        {
          "field": "current_issue_categories",
          "label": "Quali di queste problematiche riscontrate oggi?",
          "type": "multi_select",
          "options": [
            "La gestione delle commesse è manuale",
            "Non disponiamo di dati affidabili",
            "Non conosciamo lo stato delle commesse",
            "Non conosciamo le date di consegna",
            "Le informazioni dipendono dall'esperienza delle persone",
            "Non conosciamo i costi di produzione",
            "Altro"
          ]
        },
        {
          "field": "current_issue_other_text",
          "label": "Specifica",
          "type": "textarea",
          "visible_if": { "field": "current_issue_categories", "includes": "Altro" }
        }
      ]
    },
    {
      "title": "Miglioramenti desiderati",
      "phase": 1,
      "items": [
        {
          "field": "desired_improvement_categories",
          "label": "Che cosa vorreste migliorare?",
          "type": "multi_select",
          "options": [
            "Digitalizzare i processi",
            "Automatizzare la raccolta dati",
            "Pianificare meglio la produzione",
            "Conoscere il carico di lavoro di macchine e operatori",
            "Conoscere i costi di produzione",
            "Ridurre gli scarti",
            "Altro"
          ]
        },
        {
          "field": "desired_improvement_other_text",
          "label": "Specifica",
          "type": "textarea",
          "visible_if": { "field": "desired_improvement_categories", "includes": "Altro" }
        }
      ]
    },
    {
      "title": "Azienda",
      "phase": 2,
      "items": [
        { "field": "production_operators_count", "label": "Operatori di produzione", "type": "integer" },
        { "field": "technical_office_people_count", "label": "Persone nell'ufficio tecnico", "type": "integer" },
        { "field": "administrative_people_count", "label": "Persone in amministrazione", "type": "integer" },
        { "field": "other_office_people_count", "label": "Altre persone d'ufficio", "type": "integer" },
        {
          "field": "total_people_count",
          "label": "Totale persone",
          "type": "integer",
          "autosum": [
            "production_operators_count",
            "technical_office_people_count",
            "administrative_people_count",
            "other_office_people_count"
          ]
        },
        { "field": "annual_turnover_amount", "label": "Fatturato annuo", "type": "currency" }
      ]
    }
  ]
}
